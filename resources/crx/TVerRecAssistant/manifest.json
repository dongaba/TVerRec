{
	"manifest_version": 3,
	"name": "TVerRec Assistant",
	"description": "Get \"platform_uid\" , \"platform_token\" and \"member_sid\" to download your TVer favorites in TVerRec",
	"version": "0.2.0",
	"author": "dongaba",
	"homepage_url": "https://github.com/dongaba/TVerRec",
	"icons": {
		"16": "icon/TVerRec-Icon-16.png",
		"32": "icon/TVerRec-Icon-32.png",
		"48": "icon/TVerRec-Icon-48.png",
		"128": "icon/TVerRec-Icon-128.png"
	},
	"permissions": [
		"activeTab",
		"scripting"
	],
	"host_permissions": [
		"https://tver.jp/*"
	],
	"action": {
		"default_popup": "html/popup.html"
	}
}
